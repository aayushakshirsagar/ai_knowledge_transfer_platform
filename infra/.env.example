# =====================================
# Application
# =====================================

# Copy this file to .env before running the application.
# Do not commit your .env file, as it may contain secrets.

# =====================================
# Application
# =====================================

# Copy this file to .env before running the application.
# Do not commit your .env file, as it may contain secrets.

APP_NAME=Company Brain API
ENVIRONMENT=development
LOG_LEVEL=INFO

# =====================================
# AI Models
# =====================================

ANTHROPIC_API_KEY=

# URL of self-hosted Qwen/Gemma server (optional)
OPEN_SOURCE_LLM_ENDPOINT=

VOYAGE_API_KEY=

# =====================================
# Database
# =====================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/company_brain

# =====================================
# Redis
# =====================================

REDIS_URL=redis://redis:6379

# =====================================
# Qdrant
# =====================================

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# =====================================
# AWS S3
# =====================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# =====================================
# Slack Connector
# =====================================

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# =====================================
# Microsoft Graph / Teams
# =====================================

MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_TENANT_ID=

# =====================================
# Google Workspace
# =====================================

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# =====================================
# WhatsApp Business
# =====================================

WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =====================================
# Authentication
# =====================================

JWT_SECRET=change_me